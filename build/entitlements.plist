<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime.

  Keep this list as short as it can be: every entitlement here gives up a
  little of the protection the hardened runtime provides, and notarisation
  looks less kindly on a long list.

    device.camera             - the app captures live video. Under the
                                hardened runtime this is required in
                                addition to NSCameraUsageDescription.
    disable-library-validation - PyInstaller loads dozens of extension
                                modules and dylibs at runtime (OpenCV,
                                ONNX Runtime, cyndilib, Syphon). We sign
                                them all, but the loader still refuses
                                some of them without this.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
